{
	"lineWidth": 160,
	"indentWidth": 4,
	"useTabs": true,
	"newLineKind": "lf",
	"typescript": {
		"quoteStyle": "preferSingle"
	},
	"json": {
		"trailingCommas": "never"
	},
	"markdown": {
		"emphasisKind": "asterisks",
		"tags": {
			"javascript": "js",
			"typescript": "ts",
			"bash": "sh",
			"shell": "sh",
			"python": "py",
			"ruby": "rb",
			"golang": "go",
			"yaml": "yml"
		}
	},
	"malva": {},
	"yaml": {},
	"mago": {},
	"markup": {
		"preferAttrsSingleLine": true
	},
	"includes": [
		"**/*.{js,jsx,cjs,mjs,ts,tsx,json,jsonc,md}",
		"**/*.{yaml,yml}",
		"**/*.{svg,xml,html}"
	],
	"excludes": [
		"**/node_modules",
		"**/tmp",
		"**/.venv",
		"**/*.css"
	],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.95.15.wasm",
		"https://plugins.dprint.dev/json-0.21.3.wasm",
		"https://plugins.dprint.dev/markdown-0.21.1.wasm",
		"https://plugins.dprint.dev/g-plane/malva-v0.15.2.wasm",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
		"https://plugins.dprint.dev/mago-0.10.0.wasm",
		"https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.3.wasm"
	]
}
